{
  "$description": "Workflow extension for the light theme.",
  "$extensions": {
    "com.henriquearthur.dawn": {
      "css": {
        "output": "css/extensions/workflow.css",
        "selector": ":where([data-dawn])",
        "order": 10
      }
    }
  },
  "workflow": {
    "status": {
      "$type": "color",
      "backlog": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.6,
            0.017,
            240
          ]
        },
        "$description": "Backlog status."
      },
      "progress": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.66,
            0.14,
            72
          ]
        },
        "$description": "In-progress status."
      },
      "done": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.58,
            0.14,
            155
          ]
        },
        "$description": "Completed status."
      },
      "paused": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.62,
            0.14,
            82
          ]
        },
        "$description": "Paused status."
      }
    },
    "priority": {
      "1": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.56,
            0.2,
            25
          ]
        },
        "$description": "Priority 1."
      },
      "2": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.63,
            0.16,
            55
          ]
        },
        "$description": "Priority 2."
      },
      "3": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.56,
            0.11,
            240
          ]
        },
        "$description": "Priority 3."
      },
      "4": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.56,
            0.03,
            240
          ]
        },
        "$description": "Priority 4."
      },
      "$type": "color",
      "none": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.68,
            0.01,
            240
          ]
        },
        "$description": "No priority."
      }
    },
      "tint": {
        "$type": "number",
        "chroma-default": {
        "$value": 0.035,
        "$description": "Default chroma for caller-provided tint hues."
      },
      "light": {
        "surface-lightness": {
          "$value": 0.955,
          "$description": "Light-mode tint surface lightness."
        },
        "surface-chroma-multiplier": {
          "$value": 1,
          "$description": "Light-mode tint surface chroma multiplier."
        },
        "text-lightness": {
          "$value": 0.44,
          "$description": "Light-mode tint text lightness."
        },
        "text-chroma-multiplier": {
          "$value": 4,
          "$description": "Light-mode tint text chroma multiplier."
        }
      },
      "dark": {
        "surface-lightness": {
          "$value": 0.288,
          "$description": "Dark-mode tint surface lightness."
        },
        "surface-chroma-multiplier": {
          "$value": 1.6,
          "$description": "Dark-mode tint surface chroma multiplier."
        },
        "text-lightness": {
          "$value": 0.84,
          "$description": "Dark-mode tint text lightness."
        },
        "text-chroma-multiplier": {
          "$value": 2.9,
          "$description": "Dark-mode tint text chroma multiplier."
        }
      }
    }
  }
}
