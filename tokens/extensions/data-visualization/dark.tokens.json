{
  "$description": "Data visualization extension for the dark theme.",
  "$extensions": {
    "com.henriquearthur.dawn": {
      "css": {
        "output": "css/extensions/data-visualization.css",
        "selector": ":where([data-dawn][data-dawn-theme='dark'])",
        "order": 20
      }
    }
  },
  "color": {
    "$type": "color",
    "data": {
      "series": {
        "1": {
          "$value": "{color.action.primary}",
          "$description": "First chart series aliases the core primary action."
        },
        "2": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.74,
              0.13,
              170
            ]
          },
          "$description": "Second chart series."
        },
        "3": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7,
              0.12,
              250
            ]
          },
          "$description": "Third chart series."
        },
        "4": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.78,
              0.14,
              72
            ]
          },
          "$description": "Fourth chart series."
        },
        "5": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.72,
              0.16,
              330
            ]
          },
          "$description": "Fifth chart series."
        }
      }
    }
  }
}
