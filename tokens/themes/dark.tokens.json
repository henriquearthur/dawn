      "canvas": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.162,
            0.009,
            240
          ]
        },
        "$description": "Primary application surface."
      },
      "raised": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.196,
            0.011,
            240
          ]
        },
        "$description": "Raised surface such as a card."
      },
