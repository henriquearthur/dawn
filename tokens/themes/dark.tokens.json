{
  "$description": "Dawn dark theme, preserving Horizon dark values.",
  "$extensions": {
    "com.henriquearthur.dawn": {
      "css": {
        "output": "css/dawn.css",
        "selector": ":where([data-dawn][data-dawn-theme='dark'])",
        "order": 110
      }
    }
  },
  "color": {
    "$type": "color",
