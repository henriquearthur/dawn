{
  "$description": "Default Dawn light theme, preserving Horizon light values.",
  "$extensions": {
    "com.henriquearthur.dawn": {
      "css": {
        "output": "css/dawn.css",
        "selector": ":where([data-dawn])",
        "order": 100
      }
    }
  },
  "color": {
    "$type": "color",
    "surface": {
      "canvas": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.982,
            0.002,
            230
          ]
        },
        "$description": "Primary application surface."
      },
      "raised": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            1,
            0,
            0
          ]
        },
        "$description": "Raised surface such as a card."
      },
      "floating": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            1,
            0,
            0
          ]
        },
        "$description": "Floating surface such as a popover."
      },
      "muted": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.963,
            0.004,
            230
          ]
        },
        "$description": "Low-emphasis surface."
      },
      "hover": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.955,
            0.006,
            230
          ]
        },
        "$description": "Neutral hover surface."
      }
    },
    "text": {
      "primary": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.181,
            0.012,
            240
          ]
        },
        "$description": "Default foreground color."
      },
      "on-raised": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.181,
            0.012,
            240
          ]
        },
        "$description": "Foreground on a raised surface."
      },
      "on-floating": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.181,
            0.012,
            240
          ]
        },
        "$description": "Foreground on a floating surface."
      },
      "muted": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.53,
            0.017,
            240
          ]
        },
        "$description": "Low-emphasis foreground color."
      }
    },
    "action": {
      "primary": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.67,
            0.17,
            275
          ]
        },
        "$description": "Primary action color.",
        "$extensions": {
          "com.henriquearthur.dawn": {
            "css": {
              "value": "oklch(0.67 0.17 var(--dawn-accent-hue))"
