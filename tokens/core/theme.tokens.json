{
  "$description": "Dawn theme settings shared by all modes.",
  "$extensions": {
    "com.henriquearthur.dawn": {
      "css": {
        "output": "css/dawn.css",
        "selector": ":where([data-dawn])",
        "order": 0
      }
    }
  },
  "theme": {
    "accent-hue": {
      "$type": "number",
      "$value": 275,
      "$description": "The default indigo accent hue.",
      "$extensions": {
        "com.henriquearthur.dawn": {
          "css": {
            "name": "--dawn-accent-hue"
          }
        }
      }
    }
  }
}
